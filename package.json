{
	"name": "wombat",
	"version": "5.0.10",
	"engines": {
		"node": ">=22.0.0"
	},
	"license": "Apache-2.0",
	"author": "Damian Wilkołek <dwilkolek@protonmail.com>",
	"scripts": {
		"start": "tauri dev",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"eslint": "eslint",
		"format": "prettier --write .",
		"tauri": "tauri",
		"bump-version": "node bump-version.js"
	},
	"dependencies": {
		"@tauri-apps/api": "2.12.1",
		"@tauri-apps/plugin-clipboard-manager": "2.4.1",
		"@tauri-apps/plugin-dialog": "2.8.1",
		"@tauri-apps/plugin-process": "2.4.0",
		"@tauri-apps/plugin-shell": "2.4.1",
		"@tauri-apps/plugin-updater": "2.13.2",
		"daisyui": "5.7.47",
		"date-fns": "4.4.0",
		"html-to-image": "1.11.13",
		"svelte-eslint-parser": "1.8.1"
	},
	"devDependencies": {
		"@eslint/eslintrc": "3.3.7",
		"@eslint/js": "10.0.1",
		"@fontsource/fira-mono": "5.3.0",
		"@neoconfetti/svelte": "2.2.2",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/load-config": "^0.2.2",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@tauri-apps/cli": "2.12.1",
		"@types/gtag.js": "0.0.20",
		"@typescript-eslint/eslint-plugin": "8.71.1",
		"@typescript-eslint/parser": "8.71.1",
		"autoprefixer": "^10.6.1",
		"eslint": "10.12.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "17.13.0",
		"prettier": "3.9.9",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"svelte-preprocess": "6.0.5",
		"tailwindcss": "4.3.3",
		"tslib": "2.8.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.1",
		"vite": "8.3.4"
	},
	"type": "module",
	"optionalDependencies": {
		"@rollup/rollup-darwin-arm64": "4.64.3",
		"@rollup/rollup-linux-x64-gnu": "4.64.3",
		"@rollup/rollup-win32-x64-msvc": "4.64.3"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@tailwindcss/oxide",
			"esbuild",
			"svelte-preprocess"
		]
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
